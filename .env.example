# Zona horaria del contenedor
TZ=Europe/Madrid

# Horarios/modelo del agente (fijos, no configurar):
# - Modelo: xgboost
# - PRE/POST: 10 min antes/despues del cierre real de mercado
# - Alineacion: 23h55 antes del inicio de jornada

# Caducidad/alertas de token
TOKEN_MAX_AGE_HOURS=23
TOKEN_ALERT_COOLDOWN_MINUTES=360

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_ID=

# Bot de Telegram para renovar token (en el mismo contenedor)
TOKEN_BOT_ENABLED=1
TOKEN_BOT_POLL_TIMEOUT=50

# Reentrenamiento periódico del modelo xP (collect_data -> features -> train)
# Se dispara una vez al dia tras RETRAIN_TIME cuando hay jornada nueva completada
# (o, si la API no responde, cuando el dataset supera RETRAIN_MAX_AGE_DAYS).
RETRAIN_ENABLED=1
RETRAIN_TIME=05:30
RETRAIN_MAX_AGE_DAYS=7
RETRAIN_STEP_TIMEOUT_SECONDS=1800
RETRAIN_ERROR_RETRY_SECONDS=21600

# LLM (agente LangGraph por defecto; usa legacy para el ejecutor LangChain anterior)
OPENAI_API_KEY=
FANTASY_AGENT_ENGINE=langgraph
LANGCHAIN_LLM_MODEL=gpt-5-mini
LANGCHAIN_TEMPERATURE=0.1
LANGCHAIN_MAX_ITERATIONS=20
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fantasy-bot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_CALLBACKS_BACKGROUND=true
